{
  "hosting": {
    "site": "salesscore-c34f3",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/scorecard",
        "function": {
          "functionId": "kpiProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/leaderboard",
        "function": {
          "functionId": "leaderboardProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/admin/request-link",
        "function": {
          "functionId": "requestAdminLink",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/ho-mappings",
        "function": {
          "functionId": "getHoMappings",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/admin/ho-mappings",
        "function": {
          "functionId": "saveHoMappings",
          "region": "asia-south1"
        }
      },
      {
        "source": "/admin/request",
        "destination": "/admin/request.html"
      },
      {
        "source": "/api/access-config",
        "function": {
          "functionId": "getAccessConfig",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/admin/access-config",
        "function": {
          "functionId": "saveAccessConfig",
          "region": "asia-south1"
        }
      }
    ]
  }
}